# Copy this file to .env for local use: cp .env.example .env
# Keep real credentials in .env or your deployment provider's secret manager.
# Gemini: https://aistudio.google.com/apikey
# Groq:   https://console.groq.com/keys

# Model credentials. Both are used by the default Gemini + Groq pipeline.
# Keep empty in the template; add real values only to your local .env or secret store.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Model configuration. MAIN_PROVIDER selects the reasoning model (gemini or groq).
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
MAIN_PROVIDER=gemini
# Model request timeout and retry policy. Retries use exponential backoff; after
# these attempts the other provider is tried.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.25
# Shared UTC daily cap across all provider calls, including retries and fallback.
LLM_DAILY_CALL_CAP=1000

# Runtime.
PORT=8000
WEB_CONCURRENCY=1
# Runtime environment. Set APP_ENV=production in deployments.
APP_ENV=development
# Optional standard environment alias; takes precedence over APP_ENV when set.
ENV=
# Exact browser origin allowed by CORS (no wildcard).
FRONTEND_ORIGIN=http://localhost:8000
# Trusted proxy addresses for Uvicorn's forwarded client IP handling. Set to *
# only when the service is reachable exclusively through a trusted proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
# API abuse controls. Ticket limits apply independently per source IP and signed session.
TICKET_RATE_LIMIT_PER_IP=8
TICKET_RATE_LIMIT_PER_SESSION=4
TICKET_RATE_LIMIT_WINDOW_SECONDS=60
DEMO_RESET_COOLDOWN_SECONDS=60
MAX_REQUEST_BODY_BYTES=16384
# Local-only signing key for sandbox session JWTs; replace with a random secret in deployment.
AUTH_JWT_SECRET=local-only-change-me-use-a-random-secret
# Session lifetime in seconds (30 minutes by default).
SESSION_TOKEN_TTL_SECONDS=1800

# Logging accepts standard Python levels: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Database. An empty DATABASE_URL uses SQLite at DATABASE_PATH for local development.
# Set DATABASE_URL to PostgreSQL to use Postgres for orders, tickets, audit, and checkpoints.
DATABASE_URL=
DATABASE_PATH=./support_agent.db
# These values configure the local Postgres container when using Docker Compose.
POSTGRES_DB=support_agent
POSTGRES_USER=support_agent
# Local-only Compose password. Replace through your secret manager outside local development.
POSTGRES_PASSWORD=local_support_password
# Connection attempt timeout used by /ready, in seconds.
DATABASE_CONNECT_TIMEOUT=3

# LangGraph checkpoint deserialization safety setting.
LANGGRAPH_STRICT_MSGPACK=true

# Deterministic policy settings, enforced in Python code (not model prompts).
# Refund window in days from delivery.
REFUND_WINDOW_DAYS=30
# Refunds above this amount require human approval.
REFUND_AUTO_LIMIT=2000
# Maximum tool-failure retries before escalating.
MAX_LOOPS=2
